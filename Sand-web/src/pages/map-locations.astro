---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageMetadata } from '../seo/page-metadata.js';
import { getSidebarIcon, sidebarHeadIcons } from '../data/sidebar-icons.js';
import '../styles/pages/inner-page.css';
import '../styles/pages/map-locations-page.css';

const firstGuidePath = '/guides/first-stable-runs-survival-guide';

const pageUrl = '/map-locations';
const lastUpdated = '2026-06-26';
const seo = pageMetadata.mapLocations;

const locationTypes = [
  {
    id: 'named-poi',
    title: 'Named Points of Interest',
    risk: 'High value / contested',
    marker: 'POI',
    x: '17%',
    y: '29%',
    imageUrl: '/images/map-locations/sophie-ruins-route.jpg',
    imageAlt: 'SAND: Raiders of Sophie ruins and desert route screenshot from Steam',
    description:
      'Named POIs are the most reliable places to search for rare safes, Upior activity, containers, and route-defining loot. They are also obvious objectives for other crews.',
    routeUse:
      'Best used as a planned stop: park with a retreat path, clear quickly, move loot back to the Trampler, then decide whether to leave or chain into a second POI.',
    evidence:
      'GamesRadar reports Coral Chunks from rare valuables safes usually found in named POIs, and Weird Coral from Upiors often found near POIs.'
  },
  {
    id: 'wreck-fields',
    title: 'Wreck Fields and Random Shipwrecks',
    risk: 'Variable / opportunistic',
    marker: 'WRK',
    x: '66%',
    y: '28%',
    imageUrl: '/images/map-locations/sophie-desert-trampler.jpg',
    imageAlt: 'SAND: Raiders of Sophie desert Trampler screenshot from Steam',
    description:
      'Wrecks can be quick loot checks while crossing Sophie. They are not a guaranteed route anchor, but they can pull crews off their original path.',
    routeUse:
      'Treat wrecks as optional. Stop only if your Trampler can turn out cleanly and your current cargo is not already worth extracting.',
    evidence:
      'GamesRadar notes Upiors can occasionally appear at random shipwrecks, making wrecks relevant even when they are not named POIs.'
  },
  {
    id: 'evacuation-zones',
    title: 'Evacuation Zones and Radio Towers',
    risk: 'Endgame / ambush-prone',
    marker: 'EXT',
    x: '64%',
    y: '54%',
    imageUrl: '/images/map-locations/sophie-trampler-combat.jpg',
    imageAlt: 'SAND: Raiders of Sophie Trampler combat screenshot from Steam',
    description:
      'Evacuation is handled through radio towers marked by a white door-style map icon. Calling extraction creates a dangerous final phase rather than an instant exit.',
    routeUse:
      'Identify two possible exits before your cargo is full. Scout the approach, call the radio only when your Trampler can still move, then commit to the cable window.',
    evidence:
      'GamesRadar states the radio tower icon appears as a white circular door symbol; after activation, players wait 90 seconds for the dropship and then have 60 seconds to board.'
  },
  {
    id: 'open-dunes',
    title: 'Open Dunes',
    risk: 'Low cover / high visibility',
    marker: 'DUN',
    x: '46%',
    y: '69%',
    imageUrl: '/images/map-locations/sophie-desert-trampler.jpg',
    imageAlt: 'SAND: Raiders of Sophie open desert screenshot from Steam',
    description:
      'Open desert is movement space, not safety. It gives Tramplers room to maneuver, but it also exposes smoke, engine noise, and approach direction.',
    routeUse:
      'Cross dunes with a reason. Avoid stopping in open sightlines unless you are baiting, repairing behind terrain, or using distance to break contact.',
    evidence:
      'The official site describes Sophie as a desolate desert world navigated by customizable Tramplers.'
  },
  {
    id: 'sound-contact',
    title: 'Combat Sound and Trampler Contact',
    risk: 'Information / third-party risk',
    marker: 'SND',
    x: '83%',
    y: '70%',
    imageUrl: '/images/map-locations/sophie-trampler-combat.jpg',
    imageAlt: 'SAND: Raiders of Sophie mounted weapon combat screenshot from Steam',
    description:
      'Distant cannon fire and moving Tramplers are map information. They can reveal opportunity, danger, or a baited fight.',
    routeUse:
      'Do not chase every sound. If your cargo is valuable or your crew is split, sound should push you toward cover or extraction, not automatically toward combat.',
    evidence:
      'PC Gamer describes SAND as a noisy Trampler-driven PvPvE experience where distant battles can be heard across the map.'
  }
];

const routePlans = [
  {
    label: 'First Raid Loop',
    path: ['Open Dunes', 'Small POI', 'Cargo Return', 'Evacuation Zone'],
    detail:
      'Use this for learning. The goal is to understand Trampler parking, safe looting distance, and extraction timing without chaining too many objectives.'
  },
  {
    label: 'Resource Hunt Loop',
    path: ['Named POI', 'Safes', 'Upiors', 'Second POI or Extract'],
    detail:
      'Use this when looking for Coral Chunks and Weird Coral. The route is slower and louder, so set a hard exit condition before the first stop.'
  },
  {
    label: 'Storm Dive Exit Loop',
    path: ['Map Check', 'Door Icon', 'Radio Tower', 'Cable Pickup'],
    detail:
      'Use this when extraction timing matters. In Storm Dive, available towers can change because radio towers become active later and are single-use.'
  }
];

const modeRules = [
  ['Voyage', 'Radio towers are more forgiving because active towers remain available; use the mode to learn route rhythm and extraction approach angles.'],
  ['Storm Dive', 'Extraction planning is stricter because towers become available after the timer reaches the door icon and are single-use once activated.']
];

const sourceLinks = [
  ['Official SAND site', 'https://sand-game.com/', 'World, Sophie setting, Trampler role, official premise.'],
  ['Steam store page', 'https://store.steampowered.com/app/1431300/SAND_Raiders_of_Sophie/', 'Store overview, procedural desert, PvP extraction tags, screenshots.'],
  ['GamesRadar extraction guide', 'https://www.gamesradar.com/games/fps/sand-raiders-of-sophie-how-to-extract/', 'Radio tower, door icon, 90-second dropship wait, 60-second cable window, Voyage and Storm Dive notes.'],
  ['GamesRadar resource guide', 'https://www.gamesradar.com/games/fps/sand-raiders-of-sophie-coral-chunks-weird-coral/', 'Named POIs, rare valuables safes, Coral Chunks, Upiors, Weird Coral, random shipwreck note.'],
  ['PC Gamer hands-on', 'https://www.pcgamer.com/games/fps/sand-raiders-of-sophie-is-like-sea-of-thieves-on-land-but-even-tougher-for-solo-players/', 'Solo pressure, Trampler multitasking, sound and distant battle awareness.']
];
const mapHeroStats = [
  ['Location Types', String(locationTypes.length)],
  ['Route Plans', String(routePlans.length)],
  ['Source Links', String(sourceLinks.length)]
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Guide',
  name: seo.title,
  description: seo.description,
  dateModified: lastUpdated,
  inLanguage: 'en',
  about: {
    '@type': 'VideoGame',
    name: 'SAND: Raiders of Sophie'
  },
  publisher: {
    '@type': 'Organization',
    name: 'SAND Guide'
  }
};
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} pageUrl={pageUrl} structuredData={structuredData}>
<main id="main-content">
      <section class="inner-shell-section">
        <div class="container">
          <div class="inner-shell-content">
            <div class="inner-mainframe">
              <!-- 地图页首屏 -->
              <section class="map-hero-section">
                <div class="container">
                  <div class="map-hero-content">
                    <div>
                      <span>Map & Locations</span>
                      <h1>SAND: Raiders of Sophie Map - Locations &amp; Routes</h1>
                      <p>
                        SAND: Raiders of Sophie Map & Locations is a visual field reference for identifying terrain, landmark types, extraction pressure, and places that change how a run feels.
                      </p>
                      <small>Last updated: {lastUpdated}. This is a regional navigation illustration, not a claim of fixed coordinates in SAND's procedural desert.</small>
                      <div class="map-hero-strip">
                        {mapHeroStats.map(([label, value]) => (
                          <strong><span>{label}</span>{value}</strong>
                        ))}
                      </div>
                    </div>
                    <figure>
                      <img src="/images/map-locations/sophie-desert-trampler.jpg" alt="SAND: Raiders of Sophie Trampler crossing Sophie desert" />
                    </figure>
                  </div>
                </div>
              </section>

              <!-- 主地图：以地形与地点类型为核心，避免误导为固定坐标 -->
              <section id="interactive-map" class="map-board-section" aria-labelledby="map-board-title">
                <div class="container">
                  <div class="map-section-head">
                    <h2 id="map-board-title">Sophie regional field map</h2>
                    <p>Explore a SAND: Raiders of Sophie map overview of landmark types reported in current guides. Select a marker for its field brief; positions show terrain context, not fixed spawn coordinates.</p>
                  </div>
                  <div class="map-board-content">
                    <div class="map-board-shell">
                      <div class="map-board-toolbar">
                        <span>Sophie Field Map</span>
                        <b>Regional Navigation Layer</b>
                      </div>
                      <div class="map-board-canvas" aria-label="Interactive Sophie regional field map">
                        <img src="/images/map-locations/sophie-regional-field-map.png" alt="Illustrated overhead field map of Sophie's desert, ruins, wrecks, tracks, and storm edge" />
                        {locationTypes.map((location) => (
                          <a
                            href={`#${location.id}`}
                            class:list={['map-marker', `map-marker--${location.id}`]}
                            style={`--x:${location.x};--y:${location.y};`}
                          >
                            <span>{location.marker}</span>
                            <strong>{location.title}</strong>
                          </a>
                        ))}
                      </div>
                    </div>
                    <aside class="map-board-panel">
                      <h3>Map Key</h3>
                      <div class="map-key-list">
                        {locationTypes.map((location) => (
                          <a href={`#${location.id}`}>
                            <span class:list={['map-key-dot', `map-key-dot--${location.id}`]}>{location.marker}</span>
                            <b>{location.title}</b>
                          </a>
                        ))}
                      </div>
                      <h3>Field Notes</h3>
                      <ul>
                        <li>Named POIs and wrecks are location types, not permanent points.</li>
                        <li>Radio towers are an extraction system, not a static safe zone.</li>
                        <li>Open dunes amplify visibility and movement decisions.</li>
                      </ul>
                    </aside>
                  </div>
                </div>
              </section>

              <!-- 地点类型列表 -->
              <section class="map-location-section">
                <div class="container">
                  <div class="map-location-content">
                    {locationTypes.map((location) => (
                      <article id={location.id}>
                        <img src={location.imageUrl} alt={location.imageAlt} />
                        <div>
                          <small>{location.risk}</small>
                          <h2>{location.title}</h2>
                          <p>{location.description}</p>
                          <dl>
                            <div><dt>Route Use</dt><dd>{location.routeUse}</dd></div>
                            <div><dt>Evidence</dt><dd>{location.evidence}</dd></div>
                          </dl>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              </section>

              <!-- 路线建议为地图的辅助内容 -->
              <section id="route-plans" class="map-route-section">
                <div class="container">
                  <div class="map-section-head">
                    <h2>Route plans</h2>
                    <p>Use these as decision templates. They are not guaranteed spawn routes.</p>
                  </div>
                  <div class="map-route-content">
                    {routePlans.map((route) => (
                      <article>
                        <h3>{route.label}</h3>
                        <ol>
                          {route.path.map((step) => <li>{step}</li>)}
                        </ol>
                        <p>{route.detail}</p>
                      </article>
                    ))}
                  </div>
                </div>
              </section>

              <!-- 模式差异 -->
              <section class="map-mode-section">
                <div class="container">
                  <div class="map-section-head">
                    <h2>Voyage vs Storm Dive extraction planning</h2>
                  </div>
                  <div class="map-mode-content">
                    {modeRules.map(([mode, detail]) => (
                      <article>
                        <span>{mode}</span>
                        <p>{detail}</p>
                      </article>
                    ))}
                  </div>
                </div>
              </section>

              <!-- 可信度与来源 -->
              <section id="sources" class="map-source-section">
                <div class="container">
                  <div class="map-source-content">
                    <article>
                      <h2>Map accuracy note</h2>
                      <p>
                        No reliable official full-map image is currently available for SAND: Raiders of Sophie. Because Sophie is built around procedural desert routes, this page focuses on location types, route pressure, and extraction decisions instead of presenting fixed coordinates as permanent map data.
                      </p>
                    </article>
                    <div>
                      {sourceLinks.map(([label, href, note]) => (
                        <a href={href} target="_blank" rel="nofollow noopener">
                          <span>{label}</span>
                          <p>{note}</p>
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </section>
            </div>

            <aside class="inner-sidebar" aria-label="SAND map menu">
              <div class="inner-sidebar-head">
                <img src={sidebarHeadIcons.map} alt="Sophie regional field map icon" />
                <div><strong>Map</strong><span>Route Manual</span></div>
              </div>
              <nav class="inner-nav-group" aria-label="Map sections">
                <h2>Map</h2>
                <a class="is-active" href="/map-locations"><img src={getSidebarIcon('Map & Locations', '/map-locations')} alt="" /><span>Map & Locations</span><b>{locationTypes.length}</b></a>
                <a href="#interactive-map"><img src={getSidebarIcon('Regional Map', '#interactive-map')} alt="" /><span>Regional Map</span><b>Open</b></a>
                <a href="#route-plans"><img src={getSidebarIcon('Route Plans', '#route-plans')} alt="" /><span>Route Plans</span><b>{routePlans.length}</b></a>
                <a href="#sources"><img src={getSidebarIcon('Sources', '#sources')} alt="" /><span>Sources</span><b>Refs</b></a>
              </nav>
              <nav class="inner-nav-group" aria-label="Location types">
                <h2>Location Types</h2>
                {locationTypes.map((location) => (
                  <a href={`#${location.id}`}><img src={getSidebarIcon(location.title, `#${location.id}`)} alt="" /><span>{location.title}</span><b>{location.marker}</b></a>
                ))}
              </nav>
              <nav class="inner-nav-group" aria-label="Reference">
                <h2>Reference</h2>
                <a href={firstGuidePath}><img src={getSidebarIcon('Survival Guide', firstGuidePath)} alt="" /><span>Survival Guide</span><b>Guide</b></a>
                <a href="/wiki/resources"><img src={getSidebarIcon('Resources', '/wiki/resources')} alt="" /><span>Resources</span><b>Loot</b></a>
                <a href="/database"><img src={getSidebarIcon('Database', '/database')} alt="" /><span>Database</span><b>Tree</b></a>
              </nav>
            </aside>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
