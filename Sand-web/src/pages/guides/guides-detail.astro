---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedGuides } from '../../data/guides.js';
import { getSidebarIcon } from '../../data/sidebar-icons.js';
import '../../styles/pages/inner-page.css';
import '../../styles/pages/guides-detail-page.css';

const guide = publishedGuides[0];
const pageUrl = guide.addressBar;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.seo.description,
  image: guide.imageUrl,
  datePublished: guide.publishDate,
  dateModified: guide.publishDate,
  author: {
    '@type': 'Organization',
    name: 'SAND Guide Editorial'
  },
  publisher: {
    '@type': 'Organization',
    name: 'SAND Guide'
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl
  },
  about: {
    '@type': 'VideoGame',
    name: 'SAND: Raiders of Sophie'
  }
};
const guideHeroStats = [
  ['Category', guide.category],
  ['Difficulty', guide.difficulty],
  ['Read Time', guide.readingTime],
  ['Published', guide.publishDate]
];
---

<BaseLayout title={guide.seo.title} description={guide.seo.description} keywords={guide.seo.keywords} pageUrl={pageUrl} pageType="article" lastUpdated={guide.publishDate} structuredData={structuredData}>
<main>
      <section class="inner-shell-section">
        <div class="container">
          <div class="inner-shell-content">
            <aside class="inner-sidebar" aria-label="SAND guide menu">
              <div class="inner-sidebar-head">
                <img src={guide.imageUrl} alt={guide.imageAlt} />
                <div><strong>Guide</strong><span>Strategy File</span></div>
              </div>
              <nav class="inner-nav-group" aria-label="Guide Entry">
                <h2>Entry</h2>
                <a class="is-active" href="/guides/guides-detail"><img src={guide.imageUrl} alt="" /><span>{guide.title}</span><b>Open</b></a>
                <a href="/guides"><img src={getSidebarIcon('All Guides', '/guides')} alt="" /><span>All Guides</span><b>Back</b></a>
                <a href={`/guides#${guide.categorySlug}`}><img src={getSidebarIcon(guide.category, `/guides#${guide.categorySlug}`)} alt="" /><span>{guide.category}</span><b>Type</b></a>
              </nav>
              <nav class="inner-nav-group" aria-label="Reference">
                <h2>Reference</h2>
                <a href="/wiki"><img src={getSidebarIcon('Wiki', '/wiki')} alt="" /><span>Wiki</span><b>All</b></a>
                <a href="/database"><img src={getSidebarIcon('Database', '/database')} alt="" /><span>Database</span><b>Tree</b></a>
              </nav>
            </aside>
            <div class="inner-mainframe">
      <!-- 攻略详情首屏 -->
      <section class="guides-detail-hero-section">
        <div class="container">
          <div class="guides-detail-hero-content">
            <div>
              <a href="/guides">Guides</a>
              <span>{guide.category} / {guide.difficulty} / {guide.readingTime}</span>
              <h1>SAND: Raiders of Sophie Guide - {guide.title}</h1>
              <p>{guide.description}</p>
              <div class="guides-detail-hero-strip">
                {guideHeroStats.map(([label, value]) => (
                  <strong><span>{label}</span>{value}</strong>
                ))}
              </div>
            </div>
            <img src={guide.imageUrl} alt={guide.imageAlt} />
          </div>
        </div>
      </section>

      <!-- 攻略详情正文 -->
      <section class="guides-detail-body-section">
        <div class="container">
          <div class="guides-detail-body-content">
            <article set:html={guide.detailsHtml}></article>
            <aside>
              <h2>Guide File</h2>
              <p>Published {guide.publishDate}. This guide is written as a practical route planner rather than a patch-perfect database entry.</p>
              <p>Category: {guide.category}. Difficulty: {guide.difficulty}. Estimated reading time: {guide.readingTime}.</p>
              <a href="/getting-started">Read Getting Started</a>
              <a href="/wiki/resources">Open Resources Wiki</a>
              <a href="/wiki/weapons">Open Weapons Wiki</a>
              <a href="/database">Open Database</a>
            </aside>
          </div>
        </div>
      </section>
            </div>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
