---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageMetadata } from '../../seo/page-metadata.js';
import { ammunition, ammunitionFilters } from '../../data/wiki/ammunition.js';
import { weapons } from '../../data/wiki/weapons.js';
import { resources } from '../../data/wiki/resources.js';
import { getSidebarIcon, sidebarHeadIcons } from '../../data/sidebar-icons.js';
import '../../styles/pages/inner-page.css';
import '../../styles/pages/wiki-category-page.css';

const ammoGroups = [...new Set(ammunition.map((ammo) => ammo.family))].map((family) => ({
  label: family,
  items: ammunition.filter((ammo) => ammo.family === family)
}));
const ammoHeroStats = [
  ['Entries', String(ammunition.length)],
  ['Families', String(ammoGroups.length)],
  ['Linked Weapons', String(weapons.filter((weapon) => weapon.ammo).length)]
];

const seo = pageMetadata.ammunition;
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords}>
<main>
      <section class="inner-shell-section">
        <div class="container">
          <div class="inner-shell-content">
            <div class="inner-mainframe">
              <!-- Wiki二级列表：弹药 -->
              <section class="wiki-category-hero-section">
                <div class="container">
                  <div class="wiki-category-hero-content">
                    <a href="/wiki">Wiki</a>
                    <span>Ammunition</span>
                    <h1>SAND: Raiders of Sophie Wiki - Ammunition</h1>
                    <p>SAND: Raiders of Sophie Wiki - Ammunition covers rounds, shells, and rockets from the source wiki category. Each ammo entry has a dedicated page and can be linked from weapon data.</p>
                    <div class="wiki-category-hero-strip">
                      {ammoHeroStats.map(([label, value]) => (
                        <strong><span>{label}</span>{value}</strong>
                      ))}
                    </div>
                  </div>
                </div>
              </section>

              <section class="wiki-category-filter-section">
                <div class="container">
                  <div class="wiki-category-filter-content">
                    {ammunitionFilters.map((filter) => (
                      <a href={filter.value === 'All' ? '#all-ammunition' : `#${filter.value.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
                        <span>{filter.label}</span>
                        <b>{filter.count}</b>
                      </a>
                    ))}
                  </div>
                </div>
              </section>

              <section id="all-ammunition" class="wiki-category-list-section">
                <div class="container">
                  <div class="wiki-category-heading">
                    <span>All Ammunition</span>
                    <p>Inventory-style SAND: Raiders of Sophie ammunition index. Hover a slot to show the ammo name, then open its detail page.</p>
                  </div>
                  <div class="weapon-slot-grid">
                    {ammunition.map((ammo) => (
                      <a class="weapon-slot" href={`/wiki/ammunition/${ammo.addressBar}`} aria-label={ammo.title}>
                        <img src={ammo.imageUrl} alt={ammo.imageAlt} />
                        <span>{ammo.title}</span>
                        <b>{ammo.rarity}</b>
                      </a>
                    ))}
                  </div>
                </div>
              </section>

              <section class="wiki-category-list-section">
                <div class="container">
                  <div class="wiki-category-heading">
                    <span>Ammunition Families</span>
                    <p>Grouped by caliber or shell type so weapon pages can link to the correct ammo family quickly.</p>
                  </div>
                  <div class="weapon-family-table">
                    {ammoGroups.map(({ label, items }) => (
                      <div id={label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
                        <strong>{label}</strong>
                        <p>
                          {items.map((ammo) => (
                            <a href={`/wiki/ammunition/${ammo.addressBar}`}>
                              <img src={ammo.imageUrl} alt="" />
                              <span>{ammo.title}</span>
                            </a>
                          ))}
                        </p>
                      </div>
                    ))}
                  </div>
                </div>
              </section>
            </div>

            <aside class="inner-sidebar" aria-label="SAND wiki menu">
              <div class="inner-sidebar-head">
                <img src={sidebarHeadIcons.ammunition} alt="40mm shell icon for ammunition navigation" />
                <div><strong>Wiki</strong><span>Field Index</span></div>
              </div>
              <nav class="inner-nav-group" aria-label="Wiki Categories">
                <h2>Categories</h2>
                <a href="/wiki"><img src={getSidebarIcon('Wiki', '/wiki')} alt="" /><span>Wiki</span><b>All</b></a>
                <a href="/wiki/weapons"><img src={getSidebarIcon('Weapons', '/wiki/weapons')} alt="" /><span>Weapons</span><b>{weapons.length}</b></a>
                <a class="is-active" href="/wiki/ammunition"><img src={getSidebarIcon('Ammunition', '/wiki/ammunition')} alt="" /><span>Ammunition</span><b>{ammunition.length}</b></a>
                <a href="/wiki/resources"><img src={getSidebarIcon('Resources', '/wiki/resources')} alt="" /><span>Resources</span><b>{resources.length}</b></a>
              </nav>
              <nav class="inner-nav-group" aria-label="Related">
                <h2>Related</h2>
                <a href="/database"><img src={getSidebarIcon('Loadout Tree', '/database')} alt="" /><span>Loadout Tree</span><b>Tree</b></a>
                <a href="/guides"><img src={getSidebarIcon('Extraction Guides', '/guides')} alt="" /><span>Extraction Guides</span><b>List</b></a>
              </nav>
            </aside>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
