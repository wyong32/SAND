---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageMetadata } from '../../seo/page-metadata.js';
import { weapons } from '../../data/wiki/weapons.js';
import { ammunition } from '../../data/wiki/ammunition.js';
import { resources, resourceGroups, resourceStats, amplifierNotes } from '../../data/wiki/resources.js';
import { getSidebarIcon, sidebarHeadIcons } from '../../data/sidebar-icons.js';
import '../../styles/pages/inner-page.css';
import '../../styles/pages/wiki-resources-page.css';

const seo = pageMetadata.resources;
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords}>
<main>
      <section class="inner-shell-section">
        <div class="container">
          <div class="inner-shell-content">
            <aside class="inner-sidebar" aria-label="SAND wiki menu">
              <div class="inner-sidebar-head">
                <img src={sidebarHeadIcons.resources} alt="Energy rod icon for resources navigation" />
                <div><strong>Wiki</strong><span>Resources</span></div>
              </div>
              <nav class="inner-nav-group" aria-label="Wiki Categories">
                <h2>Categories</h2>
                <a href="/wiki"><img src={getSidebarIcon('Wiki', '/wiki')} alt="" /><span>Wiki</span><b>All</b></a>
                <a href="/wiki/weapons"><img src={getSidebarIcon('Weapons', '/wiki/weapons')} alt="" /><span>Weapons</span><b>{weapons.length}</b></a>
                <a href="/wiki/ammunition"><img src={getSidebarIcon('Ammunition', '/wiki/ammunition')} alt="" /><span>Ammunition</span><b>{ammunition.length}</b></a>
                <a class="is-active" href="/wiki/resources"><img src={getSidebarIcon('Resources', '/wiki/resources')} alt="" /><span>Resources</span><b>{resources.length}</b></a>
              </nav>
              <nav class="inner-nav-group" aria-label="Resource Groups">
                <h2>Groups</h2>
                {resourceGroups.map((group) => (
                  <a href={`#${group.id}`}><img src={getSidebarIcon(group.title, `#${group.id}`)} alt="" /><span>{group.title.replace(' Resources', '')}</span><b>{group.items.length}</b></a>
                ))}
              </nav>
            </aside>
            <div class="inner-mainframe">
              <!-- Wiki资源页首屏 -->
              <section class="wiki-resources-hero-section">
                <div class="container">
                  <div class="wiki-resources-hero-content">
                    <div class="wiki-resources-hero-copy">
                      <a href="/wiki">Wiki</a>
                      <span>Resources / Loot Index</span>
                      <h1>SAND: Raiders of Sophie Wiki - Resources</h1>
                      <p>Resource entries are grouped to match the Steam guide structure: common, uncommon, rare, noteworthy, experimental, boxes, and amplifiers.</p>
                    </div>
                    <div class="wiki-resources-hero-stats">
                      {resourceStats.map(([label, value]) => (
                        <strong><span>{value}</span>{label}</strong>
                      ))}
                    </div>
                  </div>
                </div>
              </section>

              <!-- 资源图标总览 -->
              <section class="wiki-resources-grid-section">
                <div class="container">
                  <div class="wiki-resources-section-heading">
                    <span>All Resource Icons</span>
                    <p>Inventory-style overview following the source guide order.</p>
                  </div>
                  <div class="wiki-resources-icon-grid">
                    {resources.map((resource) => (
                      <a href={`#resource-${resource.id}`} aria-label={resource.title}>
                        <img src={resource.imageUrl} alt={resource.imageAlt} />
                        <span>{resource.title}</span>
                        <b>{resource.group.replace(' Resources', '')}</b>
                      </a>
                    ))}
                  </div>
                </div>
              </section>

              <!-- 来源分组列表 -->
              <section class="wiki-resources-list-section">
                <div class="container">
                  <div class="wiki-resources-list-content">
                    {resourceGroups.map((group) => (
                      <section id={group.id}>
                        <div class="wiki-resources-section-heading">
                          <span>{group.title}</span>
                          <p>{group.items.length} entries in the same order as the Steam community guide section.</p>
                        </div>
                        <div class="wiki-resources-table">
                          {group.items.map((resource) => (
                            <article id={`resource-${resource.id}`}>
                              <img src={resource.imageUrl} alt={resource.imageAlt} />
                              <div>
                                <small>{resource.guideLabel}</small>
                                <h2>{resource.title}</h2>
                                <p>{resource.use}</p>
                              </div>
                              <dl>
                                <div><dt>Type</dt><dd>{resource.type}</dd></div>
                                <div><dt>Found In</dt><dd>{resource.source}</dd></div>
                                <div><dt>Field Note</dt><dd>{resource.fieldNote}</dd></div>
                              </dl>
                            </article>
                          ))}
                        </div>
                      </section>
                    ))}
                  </div>
                </div>
              </section>

              <!-- 箱子与增幅器 -->
              <section class="wiki-resources-extra-section">
                <div class="container">
                  <div class="wiki-resources-extra-content">
                    <article>
                      <span>Boxes</span>
                      <h2>Boxes and crates are the repeatable source layer.</h2>
                      <p>The Steam guide lists most ordinary resources as specialized box or crate drops. This page keeps those entries under each item instead of flattening them into one generic note.</p>
                    </article>
                    <div>
                      {amplifierNotes.map((amplifier) => (
                        <article>
                          <img src={amplifier.imageUrl} alt={`${amplifier.title} icon in SAND: Raiders of Sophie`} />
                          <h2>{amplifier.title}</h2>
                          <p>{amplifier.description}</p>
                        </article>
                      ))}
                    </div>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
