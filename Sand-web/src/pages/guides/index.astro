---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageMetadata } from '../../seo/page-metadata.js';
import { publishedGuides } from '../../data/guides.js';
import { getSidebarIcon, sidebarHeadIcons } from '../../data/sidebar-icons.js';
import '../../styles/pages/inner-page.css';
import '../../styles/pages/guides-list-page.css';

const guideGroups = [...new Set(publishedGuides.map((guide) => guide.category))].map((category) => ({
  category,
  key: category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
  guides: publishedGuides.filter((guide) => guide.category === category)
}));
const featuredGuide = publishedGuides[0];
const guideHref = (guide: { addressBar: string }) => `/guides/${guide.addressBar}`;
const categoryHref = (group: { key: string }) => `/guides?category=${group.key}`;
const guideHeroStats = [
  ['Published', String(publishedGuides.length)],
  ['Collections', String(guideGroups.length)],
  ['Updated', featuredGuide?.publishDate || 'No guides yet']
];

const seo = pageMetadata.guidesList;
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords}>
<main>
      <section class="inner-shell-section">
        <div class="container">
          <div class="inner-shell-content">
            <div class="inner-mainframe">
      <!-- 攻略列表首屏 -->
      <section class="guides-list-hero-section">
        <div class="container">
          <div class="guides-list-hero-content">
            <div class="guides-list-hero-copy">
              <span>Guides</span>
              <h1>SAND: Raiders of Sophie Guides - Survival, Extraction &amp; Strategy</h1>
              <p>SAND: Raiders of Sophie Guides collects clear, practical reads for making better decisions across Sophie, from first raids to extraction discipline.</p>
              <div class="guides-list-hero-strip">
                {guideHeroStats.map(([label, value]) => (
                  <strong><span>{label}</span>{value}</strong>
                ))}
              </div>
            </div>
            {featuredGuide && <a class="guides-list-hero-feature" href={guideHref(featuredGuide)}><img src={featuredGuide.imageUrl} alt={featuredGuide.imageAlt} /><div><small>{featuredGuide.category}</small><b>{featuredGuide.title}</b></div></a>}
          </div>
        </div>
      </section>

<!-- 广告位：Native Banner -->
<aside class="container" style="display: flex; justify-content: center; align-items: center;" aria-label="Advertisement">
  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      window.setTimeout(() => {
        const script = document.createElement('script');
        script.async = true;
        script.setAttribute('data-cfasync', 'false');
        script.src = 'https://pl30122457.effectivecpmnetwork.com/57f4b2a1bba7b95f65f276c1cd603a1b/invoke.js';
        currentScript.after(script);
      }, 2000);
    })();
  </script>
  <div id="container-57f4b2a1bba7b95f65f276c1cd603a1b"></div>
</aside>

      <!-- 攻略文章列表 -->
      <section class="guides-list-grid-section">
        <div class="container">
          <div class="guides-list-grid-content">
            <div class="guides-list-filter-head" data-guide-filter-head hidden>
              <span>Filtered Collection</span>
              <h2 data-guide-filter-title>All SAND: Raiders of Sophie Guides</h2>
              <a href="/guides" data-guide-clear>Show all guides</a>
            </div>
            {guideGroups.map((group, groupIndex) => (
              <section class="guides-category-section" data-guide-category={group.key} data-guide-category-label={group.category}>
                <div class="guides-category-head">
                  <span>Collection {String(groupIndex + 1).padStart(2, '0')}</span>
                  <h2>{group.category}</h2>
                  <b>{group.guides.length} published</b>
                </div>
                <div class="guides-category-grid" style={`--guide-count:${group.guides.length};`}>
                  {group.guides.map((guide, guideIndex) => (
                    <article class:list={{ 'guides-featured-entry': guideIndex === 0 }}>
                      <a class="guides-entry-image" href={guideHref(guide)} aria-label={`Read ${guide.title}`}>
                        <img src={guide.imageUrl} alt={guide.imageAlt} />
                        <span>Read Field Guide</span>
                      </a>
                      <div class="guides-entry-copy">
                        <div class="guides-entry-meta">
                          <small>{guide.category}</small>
                          <b>{guide.publishDate}</b>
                        </div>
                        <h3><a href={guideHref(guide)}>{guide.title}</a></h3>
                        <p>{guide.description}</p>
                        <div class="guides-entry-footer">
                          <time datetime={guide.publishDate}>{guide.publishDate}</time>
                          <a href={guideHref(guide)}>Read full SAND survival guide <span aria-hidden="true">&#8594;</span></a>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </section>

<!-- 广告位：728x90 Banner，移动端 300x250 -->
<aside class="container" style="display: flex; justify-content: center; align-items: center;" aria-label="Advertisement">
  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      window.setTimeout(() => {
        const isMobileAd = window.matchMedia('(max-width: 768px)').matches;
        const iframe = document.createElement('iframe');
        iframe.width = isMobileAd ? '300' : '728';
        iframe.height = isMobileAd ? '250' : '90';
        iframe.setAttribute('scrolling', 'no');
        iframe.setAttribute('frameborder', '0');
        iframe.style.border = '0';
        iframe.style.overflow = 'hidden';
        iframe.srcdoc = isMobileAd
          ? `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'da035ce315f9162bdb39be5b5dab7c6f',format:'iframe',height:250,width:300,params:{}};<\/script><script src="https://www.highperformanceformat.com/da035ce315f9162bdb39be5b5dab7c6f/invoke.js"><\/script></body></html>`
          : `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'e9cbeb7d55584c1e4df8907d619b545c',format:'iframe',height:90,width:728,params:{}};<\/script><script src="https://www.highperformanceformat.com/e9cbeb7d55584c1e4df8907d619b545c/invoke.js"><\/script></body></html>`;
        currentScript.after(iframe);
      }, 2000);
    })();
  </script>
</aside>
      
            </div>

            <aside class="inner-sidebar" aria-label="SAND guides menu">
              <div class="inner-sidebar-head">
                <img src={sidebarHeadIcons.guides} alt="Orbital strike pointer icon for guides navigation" />
                <div><strong>Guides</strong><span>Strategy Board</span></div>
              </div>
              <nav class="inner-nav-group" aria-label="Guide Categories">
                <h2>Categories</h2>
                <a class="is-active" href="/guides" data-guide-all><img src={getSidebarIcon('All Guides', '/guides')} alt="" /><span>All Guides</span><b>{publishedGuides.length}</b></a>
                {guideGroups.map((group) => (
                  <a href={categoryHref(group)} data-guide-filter={group.key}><img src={getSidebarIcon(group.category, categoryHref(group))} alt="" /><span>{group.category}</span><b>{group.guides.length}</b></a>
                ))}
                <a href="/getting-started"><img src={getSidebarIcon('Getting Started', '/getting-started')} alt="" /><span>Getting Started</span><b>Start</b></a>
              </nav>
              <nav class="inner-nav-group" aria-label="Reference">
                <h2>Reference</h2>
                <a href="/wiki"><img src={getSidebarIcon('Wiki', '/wiki')} alt="" /><span>Wiki</span><b>All</b></a>
                <a href="/database"><img src={getSidebarIcon('Database', '/database')} alt="" /><span>Database</span><b>Tree</b></a>
              </nav>
            </aside>
          </div>
        </div>
      </section>
    </main>
    <script is:inline>
      (() => {
        const sections = [...document.querySelectorAll('[data-guide-category]')];
        const filters = [...document.querySelectorAll('[data-guide-filter]')];
        const allLink = document.querySelector('[data-guide-all]');
        const filterHead = document.querySelector('[data-guide-filter-head]');
        const filterTitle = document.querySelector('[data-guide-filter-title]');

        const applyGuideCategory = (rawCategory) => {
          const category = (rawCategory || '').trim();
          const activeSection = sections.find((section) => section.getAttribute('data-guide-category') === category);

          sections.forEach((section) => {
            const shouldHide = Boolean(category) && section !== activeSection;
            section.hidden = shouldHide;
            if (section instanceof HTMLElement) {
              section.style.display = shouldHide ? 'none' : '';
            }
          });

          allLink?.classList.toggle('is-active', !category || !activeSection);
          filters.forEach((link) => {
            link.classList.toggle('is-active', Boolean(activeSection) && link.getAttribute('data-guide-filter') === category);
          });

          if (filterHead instanceof HTMLElement) {
            filterHead.hidden = !activeSection;
          }

          if (filterTitle && activeSection) {
            const label = activeSection.getAttribute('data-guide-category-label') || 'Selected Guides';
            filterTitle.textContent = `${label} Guides`;
          }
        };

        const params = new URLSearchParams(window.location.search);
        applyGuideCategory(params.get('category'));

        allLink?.addEventListener('click', (event) => {
          event.preventDefault();
          history.pushState(null, '', '/guides');
          applyGuideCategory('');
        });

        filters.forEach((link) => {
          link.addEventListener('click', (event) => {
            event.preventDefault();
            const category = link.getAttribute('data-guide-filter') || '';
            history.pushState(null, '', `/guides?category=${encodeURIComponent(category)}`);
            applyGuideCategory(category);
          });
        });

        window.addEventListener('popstate', () => {
          const nextParams = new URLSearchParams(window.location.search);
          applyGuideCategory(nextParams.get('category'));
        });
      })();
    </script>
</BaseLayout>
