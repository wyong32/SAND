---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageMetadata } from '../../seo/page-metadata.js';
import { weapons } from '../../data/wiki/weapons.js';
import { ammunition } from '../../data/wiki/ammunition.js';
import { resources, resourceGroups, resourceStats, amplifierNotes } from '../../data/wiki/resources.js';
import { getSidebarIcon, sidebarHeadIcons } from '../../data/sidebar-icons.js';
import '../../styles/pages/inner-page.css';
import '../../styles/pages/wiki-resources-page.css';

const seo = pageMetadata.resources;
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords}>
<main>
      <section class="inner-shell-section">
        <div class="container">
          <div class="inner-shell-content">
            <div class="inner-mainframe">
              <!-- Wiki资源页首屏 -->
              <section class="wiki-resources-hero-section">
                <div class="container">
                  <div class="wiki-resources-hero-content">
                    <div class="wiki-resources-hero-copy">
                      <a href="/wiki">Wiki</a>
                      <span>Resources / Loot Index</span>
                      <h1>SAND: Raiders of Sophie Wiki - Resources</h1>
                      <p>SAND: Raiders of Sophie Wiki - Resources groups loot and crafting materials by rarity, special item role, boxes, and amplifiers. Use it with the <a href="/database">Trampler tech tree database</a> when checking upgrade materials.</p>
                    </div>
                    <div class="wiki-resources-hero-stats">
                      {resourceStats.map(([label, value]) => (
                        <strong><span>{value}</span>{label}</strong>
                      ))}
                    </div>
                  </div>
                </div>
              </section>

<!-- 广告位：Native Banner -->
<aside class="container" style="display: flex; justify-content: center; align-items: center;" aria-label="Advertisement">
  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      window.setTimeout(() => {
        const script = document.createElement('script');
        script.async = true;
        script.setAttribute('data-cfasync', 'false');
        script.src = 'https://pl30122457.effectivecpmnetwork.com/57f4b2a1bba7b95f65f276c1cd603a1b/invoke.js';
        currentScript.after(script);
      }, 2000);
    })();
  </script>
  <div id="container-57f4b2a1bba7b95f65f276c1cd603a1b"></div>
</aside>

              <!-- 资源图标总览 -->
              <section class="wiki-resources-grid-section">
                <div class="container">
                  <div class="wiki-resources-section-heading">
                    <span>All Resource Icons</span>
                    <p>Inventory-style SAND: Raiders of Sophie resources overview for quick scanning, with each entry connected to its practical use and field note.</p>
                  </div>
                  <div class="wiki-resources-icon-grid">
                    {resources.map((resource) => (
                      <a href={`#resource-${resource.id}`} aria-label={resource.title}>
                        <img src={resource.imageUrl} alt={resource.imageAlt} />
                        <span>{resource.title}</span>
                        <b>{resource.group.replace(' Resources', '')}</b>
                      </a>
                    ))}
                  </div>
                </div>
              </section>

<!-- 广告位：728x90 Banner，移动端 300x250 -->
<aside class="container" style="display: flex; justify-content: center; align-items: center;" aria-label="Advertisement">
  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      window.setTimeout(() => {
        const isMobileAd = window.matchMedia('(max-width: 768px)').matches;
        const iframe = document.createElement('iframe');
        iframe.width = isMobileAd ? '300' : '728';
        iframe.height = isMobileAd ? '250' : '90';
        iframe.setAttribute('scrolling', 'no');
        iframe.setAttribute('frameborder', '0');
        iframe.style.border = '0';
        iframe.style.overflow = 'hidden';
        iframe.srcdoc = isMobileAd
          ? `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'da035ce315f9162bdb39be5b5dab7c6f',format:'iframe',height:250,width:300,params:{}};<\/script><script src="https://www.highperformanceformat.com/da035ce315f9162bdb39be5b5dab7c6f/invoke.js"><\/script></body></html>`
          : `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'e9cbeb7d55584c1e4df8907d619b545c',format:'iframe',height:90,width:728,params:{}};<\/script><script src="https://www.highperformanceformat.com/e9cbeb7d55584c1e4df8907d619b545c/invoke.js"><\/script></body></html>`;
        currentScript.after(iframe);
      }, 2000);
    })();
  </script>
</aside>

              <!-- 来源分组列表 -->
              <section class="wiki-resources-list-section">
                <div class="container">
                  <div class="wiki-resources-list-content">
                    {resourceGroups.map((group) => (
                      <section id={group.id}>
                        <div class="wiki-resources-section-heading">
                          <span>{group.title}</span>
                          <p>{group.items.length} SAND: Raiders of Sophie resource entries organized for loot planning, crafting checks, and Trampler upgrade decisions.</p>
                        </div>
                        <div class="wiki-resources-table">
                          {group.items.map((resource) => (
                            <article id={`resource-${resource.id}`}>
                              <img src={resource.imageUrl} alt={resource.imageAlt} />
                              <div>
                                <small>{resource.guideLabel}</small>
                                <h2>{resource.title}</h2>
                                <p>{resource.use}</p>
                              </div>
                              <dl>
                                <div><dt>Type</dt><dd>{resource.type}</dd></div>
                                <div><dt>Found In</dt><dd>{resource.source}</dd></div>
                                <div><dt>Field Note</dt><dd>{resource.fieldNote}</dd></div>
                              </dl>
                            </article>
                          ))}
                        </div>
                      </section>

<!-- 广告位：728x90 Banner，移动端 300x250 -->
<aside class="container" style="display: flex; justify-content: center; align-items: center;" aria-label="Advertisement">
  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      window.setTimeout(() => {
        const isMobileAd = window.matchMedia('(max-width: 768px)').matches;
        const iframe = document.createElement('iframe');
        iframe.width = isMobileAd ? '300' : '728';
        iframe.height = isMobileAd ? '250' : '90';
        iframe.setAttribute('scrolling', 'no');
        iframe.setAttribute('frameborder', '0');
        iframe.style.border = '0';
        iframe.style.overflow = 'hidden';
        iframe.srcdoc = isMobileAd
          ? `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'da035ce315f9162bdb39be5b5dab7c6f',format:'iframe',height:250,width:300,params:{}};<\/script><script src="https://www.highperformanceformat.com/da035ce315f9162bdb39be5b5dab7c6f/invoke.js"><\/script></body></html>`
          : `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'e9cbeb7d55584c1e4df8907d619b545c',format:'iframe',height:90,width:728,params:{}};<\/script><script src="https://www.highperformanceformat.com/e9cbeb7d55584c1e4df8907d619b545c/invoke.js"><\/script></body></html>`;
        currentScript.after(iframe);
      }, 2000);
    })();
  </script>
</aside>
                    ))}
                  </div>
                </div>
              </section>

              <!-- 箱子与增幅器 -->
              <section class="wiki-resources-extra-section">
                <div class="container">
                  <div class="wiki-resources-extra-content">
                    <article>
                      <span>Boxes</span>
                      <h2>Boxes and crates are the repeatable source layer.</h2>
                      <p>Many ordinary SAND: Raiders of Sophie resources are tied to specialized boxes or crates. This page keeps those notes under each item instead of flattening them into one generic line, then connects resource planning back to the <a href="/database">SAND Database</a> and <a href="/guides">strategy guides</a>.</p>
                    </article>
                    <div>
                      {amplifierNotes.map((amplifier) => (
                        <article>
                          <img src={amplifier.imageUrl} alt={`${amplifier.title} icon in SAND: Raiders of Sophie`} />
                          <h2>{amplifier.title}</h2>
                          <p>{amplifier.description}</p>
                        </article>
                      ))}
                    </div>
                  </div>
                </div>
              </section>

<!-- 广告位：728x90 Banner，移动端 300x250 -->
<aside class="container" style="display: flex; justify-content: center; align-items: center;" aria-label="Advertisement">
  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      window.setTimeout(() => {
        const isMobileAd = window.matchMedia('(max-width: 768px)').matches;
        const iframe = document.createElement('iframe');
        iframe.width = isMobileAd ? '300' : '728';
        iframe.height = isMobileAd ? '250' : '90';
        iframe.setAttribute('scrolling', 'no');
        iframe.setAttribute('frameborder', '0');
        iframe.style.border = '0';
        iframe.style.overflow = 'hidden';
        iframe.srcdoc = isMobileAd
          ? `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'da035ce315f9162bdb39be5b5dab7c6f',format:'iframe',height:250,width:300,params:{}};<\/script><script src="https://www.highperformanceformat.com/da035ce315f9162bdb39be5b5dab7c6f/invoke.js"><\/script></body></html>`
          : `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'e9cbeb7d55584c1e4df8907d619b545c',format:'iframe',height:90,width:728,params:{}};<\/script><script src="https://www.highperformanceformat.com/e9cbeb7d55584c1e4df8907d619b545c/invoke.js"><\/script></body></html>`;
        currentScript.after(iframe);
      }, 2000);
    })();
  </script>
</aside>
            </div>

            <aside class="inner-sidebar" aria-label="SAND wiki menu">
              <div class="inner-sidebar-head">
                <img src={sidebarHeadIcons.resources} alt="Energy rod icon for resources navigation" />
                <div><strong>Wiki</strong><span>Resources</span></div>
              </div>
              <nav class="inner-nav-group" aria-label="Wiki Categories">
                <h2>Categories</h2>
                <a href="/wiki"><img src={getSidebarIcon('Wiki', '/wiki')} alt="" /><span>Wiki</span><b>All</b></a>
                <a href="/wiki/weapons"><img src={getSidebarIcon('Weapons', '/wiki/weapons')} alt="" /><span>Weapons</span><b>{weapons.length}</b></a>
                <a href="/wiki/ammunition"><img src={getSidebarIcon('Ammunition', '/wiki/ammunition')} alt="" /><span>Ammunition</span><b>{ammunition.length}</b></a>
                <a class="is-active" href="/wiki/resources"><img src={getSidebarIcon('Resources', '/wiki/resources')} alt="" /><span>Resources</span><b>{resources.length}</b></a>
              </nav>
              <nav class="inner-nav-group" aria-label="Resource Groups">
                <h2>Groups</h2>
                {resourceGroups.map((group) => (
                  <a href={`#${group.id}`}><img src={getSidebarIcon(group.title, `#${group.id}`)} alt="" /><span>{group.title.replace(' Resources', '')}</span><b>{group.items.length}</b></a>
                ))}
              </nav>
            </aside>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
