---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageMetadata } from '../../seo/page-metadata.js';
import { weaponFilters, weapons } from '../../data/wiki/weapons.js';
import { ammunition } from '../../data/wiki/ammunition.js';
import { resources } from '../../data/wiki/resources.js';
import { getSidebarIcon, sidebarHeadIcons } from '../../data/sidebar-icons.js';
import '../../styles/pages/inner-page.css';
import '../../styles/pages/wiki-category-page.css';

const playerWeapons = weapons.filter((weapon) => weapon.category === 'Player Weapons');
const mountedWeapons = weapons.filter((weapon) => weapon.category === 'Mounted Weapons');
const weaponGroups = [
  { label: 'Handguns', items: playerWeapons.filter((weapon) => weapon.family === 'Handgun') },
  { label: 'Rifles', items: playerWeapons.filter((weapon) => weapon.family === 'Rifle') },
  { label: 'Shotguns', items: playerWeapons.filter((weapon) => weapon.family === 'Shotgun') },
  { label: 'Throwables', items: playerWeapons.filter((weapon) => weapon.family === 'Throwable') },
  { label: 'Special', items: playerWeapons.filter((weapon) => weapon.family === 'Special') }
].filter((entry) => entry.items.length > 0);
const weaponHeroStats = [
  ['Entries', String(weapons.length)],
  ['Player', String(playerWeapons.length)],
  ['Mounted', String(mountedWeapons.length)]
];

const seo = pageMetadata.weapons;
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords}>
<main>
      <section class="inner-shell-section">
        <div class="container">
          <div class="inner-shell-content">
            <div class="inner-mainframe">
      <!-- Wiki二级列表：武器 -->
      <section class="wiki-category-hero-section">
        <div class="container">
          <div class="wiki-category-hero-content">
            <a href="/wiki">Wiki</a>
            <span>Combat Systems</span>
            <h1>SAND: Raiders of Sophie Wiki - Weapons</h1>
            <p>SAND: Raiders of Sophie Wiki - Weapons organizes the weapon grid by practical category. Entries are grouped as Player Weapons and Mounted Weapons, with individual pages for each weapon.</p>
            <div class="wiki-category-hero-strip">
              {weaponHeroStats.map(([label, value]) => (
                <strong><span>{label}</span>{value}</strong>
              ))}
            </div>
          </div>
        </div>
      </section>

<!-- 广告位：Native Banner -->
<aside class="container" style="display: flex; justify-content: center; align-items: center;" aria-label="Advertisement">
  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      window.setTimeout(() => {
        const script = document.createElement('script');
        script.async = true;
        script.setAttribute('data-cfasync', 'false');
        script.src = 'https://pl30122457.effectivecpmnetwork.com/57f4b2a1bba7b95f65f276c1cd603a1b/invoke.js';
        currentScript.after(script);
      }, 2000);
    })();
  </script>
  <div id="container-57f4b2a1bba7b95f65f276c1cd603a1b"></div>
</aside>

      <section class="wiki-category-filter-section">
        <div class="container">
          <div class="wiki-category-filter-content">
            {weaponFilters.map((filter) => (
              <a href={filter.value === 'Mounted Weapons' ? '#mounted-weapons' : filter.value === 'Player Weapons' ? '#player-weapons' : '#all-weapons'}>
                <span>{filter.label}</span>
                <b>{filter.count}</b>
              </a>
            ))}
          </div>
        </div>
      </section>
      

      <section id="all-weapons" class="wiki-category-list-section">
        <div class="container">
          <div class="wiki-category-heading">
            <span>All Weapons</span>
            <p>Inventory-style SAND: Raiders of Sophie weapons index. Hover a slot to show the weapon name, then open the dedicated detail page.</p>
          </div>
          <div class="weapon-slot-grid">
            {weapons.map((weapon) => (
              <a class:list={['weapon-slot', weapon.category === 'Mounted Weapons' && 'is-mounted']} href={`/wiki/weapons/${weapon.addressBar}`} aria-label={weapon.title}>
                <img src={weapon.imageUrl} alt={weapon.imageAlt} />
                <span>{weapon.title}</span>
                <b>{weapon.rarity}</b>
              </a>
            ))}
          </div>
        </div>
      </section>

<!-- 广告位：728x90 Banner，移动端 300x250 -->
<aside class="container" style="display: flex; justify-content: center; align-items: center;" aria-label="Advertisement">
  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      window.setTimeout(() => {
        const isMobileAd = window.matchMedia('(max-width: 768px)').matches;
        const iframe = document.createElement('iframe');
        iframe.width = isMobileAd ? '300' : '728';
        iframe.height = isMobileAd ? '250' : '90';
        iframe.setAttribute('scrolling', 'no');
        iframe.setAttribute('frameborder', '0');
        iframe.style.border = '0';
        iframe.style.overflow = 'hidden';
        iframe.srcdoc = isMobileAd
          ? `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'da035ce315f9162bdb39be5b5dab7c6f',format:'iframe',height:250,width:300,params:{}};<\/script><script src="https://www.highperformanceformat.com/da035ce315f9162bdb39be5b5dab7c6f/invoke.js"><\/script></body></html>`
          : `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'e9cbeb7d55584c1e4df8907d619b545c',format:'iframe',height:90,width:728,params:{}};<\/script><script src="https://www.highperformanceformat.com/e9cbeb7d55584c1e4df8907d619b545c/invoke.js"><\/script></body></html>`;
        currentScript.after(iframe);
      }, 2000);
    })();
  </script>
</aside>

      <section id="player-weapons" class="wiki-category-list-section">
        <div class="container">
          <div class="wiki-category-heading">
            <span>Player Weapons</span>
            <p>Grouped for carried weapon lookup, ammo comparison, and loadout planning.</p>
          </div>
          <div class="weapon-family-table">
            {weaponGroups.map(({ label, items }) => (
              <div>
                <strong>{label}</strong>
                <p>
                  {items.map((weapon) => (
                    <a href={`/wiki/weapons/${weapon.addressBar}`}>
                      <img src={weapon.imageUrl} alt="" />
                      <span>{weapon.title}</span>
                    </a>
                  ))}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

<!-- 广告位：728x90 Banner，移动端 300x250 -->
<aside class="container" style="display: flex; justify-content: center; align-items: center;" aria-label="Advertisement">
  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      window.setTimeout(() => {
        const isMobileAd = window.matchMedia('(max-width: 768px)').matches;
        const iframe = document.createElement('iframe');
        iframe.width = isMobileAd ? '300' : '728';
        iframe.height = isMobileAd ? '250' : '90';
        iframe.setAttribute('scrolling', 'no');
        iframe.setAttribute('frameborder', '0');
        iframe.style.border = '0';
        iframe.style.overflow = 'hidden';
        iframe.srcdoc = isMobileAd
          ? `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'da035ce315f9162bdb39be5b5dab7c6f',format:'iframe',height:250,width:300,params:{}};<\/script><script src="https://www.highperformanceformat.com/da035ce315f9162bdb39be5b5dab7c6f/invoke.js"><\/script></body></html>`
          : `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'e9cbeb7d55584c1e4df8907d619b545c',format:'iframe',height:90,width:728,params:{}};<\/script><script src="https://www.highperformanceformat.com/e9cbeb7d55584c1e4df8907d619b545c/invoke.js"><\/script></body></html>`;
        currentScript.after(iframe);
      }, 2000);
    })();
  </script>
</aside>

      <section id="mounted-weapons" class="wiki-category-list-section">
        <div class="container">
          <div class="wiki-category-heading">
            <span>Mounted Weapons</span>
            <p>Trampler-mounted cannons for vehicle combat, defensive arcs, and pressure against enemy walkers.</p>
          </div>
          <div class="weapon-slot-grid is-mounted-grid">
            {mountedWeapons.map((weapon) => (
              <a class="weapon-slot is-mounted" href={`/wiki/weapons/${weapon.addressBar}`} aria-label={weapon.title}>
                <img src={weapon.imageUrl} alt={weapon.imageAlt} />
                <span>{weapon.title}</span>
                <b>{weapon.rarity}</b>
              </a>
            ))}
          </div>
        </div>
      </section>

<!-- 广告位：728x90 Banner，移动端 300x250 -->
<aside class="container" style="display: flex; justify-content: center; align-items: center;" aria-label="Advertisement">
  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      window.setTimeout(() => {
        const isMobileAd = window.matchMedia('(max-width: 768px)').matches;
        const iframe = document.createElement('iframe');
        iframe.width = isMobileAd ? '300' : '728';
        iframe.height = isMobileAd ? '250' : '90';
        iframe.setAttribute('scrolling', 'no');
        iframe.setAttribute('frameborder', '0');
        iframe.style.border = '0';
        iframe.style.overflow = 'hidden';
        iframe.srcdoc = isMobileAd
          ? `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'da035ce315f9162bdb39be5b5dab7c6f',format:'iframe',height:250,width:300,params:{}};<\/script><script src="https://www.highperformanceformat.com/da035ce315f9162bdb39be5b5dab7c6f/invoke.js"><\/script></body></html>`
          : `<!doctype html><html><body style="margin:0;overflow:hidden;"><script>atOptions={key:'e9cbeb7d55584c1e4df8907d619b545c',format:'iframe',height:90,width:728,params:{}};<\/script><script src="https://www.highperformanceformat.com/e9cbeb7d55584c1e4df8907d619b545c/invoke.js"><\/script></body></html>`;
        currentScript.after(iframe);
      }, 2000);
    })();
  </script>
</aside>
            </div>

            <aside class="inner-sidebar" aria-label="SAND wiki menu">
              <div class="inner-sidebar-head">
                <img src={sidebarHeadIcons.weapons} alt="Anti-Reactor Rifle icon for weapons navigation" />
                <div><strong>Wiki</strong><span>Field Index</span></div>
              </div>
              <nav class="inner-nav-group" aria-label="Wiki Categories">
                <h2>Categories</h2>
                <a href="/wiki"><img src={getSidebarIcon('Wiki', '/wiki')} alt="" /><span>Wiki</span><b>All</b></a>
                <a class="is-active" href="/wiki/weapons"><img src={getSidebarIcon('Weapons', '/wiki/weapons')} alt="" /><span>Weapons</span><b>{weapons.length}</b></a>
                <a href="/wiki/ammunition"><img src={getSidebarIcon('Ammunition', '/wiki/ammunition')} alt="" /><span>Ammunition</span><b>{ammunition.length}</b></a>
                <a href="/wiki/resources"><img src={getSidebarIcon('Resources', '/wiki/resources')} alt="" /><span>Resources</span><b>{resources.length}</b></a>
              </nav>
              <nav class="inner-nav-group" aria-label="Related">
                <h2>Related</h2>
                <a href="/database"><img src={getSidebarIcon('Trampler Tech', '/database')} alt="" /><span>Trampler Tech</span><b>Tree</b></a>
                <a href="/guides"><img src={getSidebarIcon('Combat Guides', '/guides')} alt="" /><span>Combat Guides</span><b>List</b></a>
              </nav>
            </aside>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
