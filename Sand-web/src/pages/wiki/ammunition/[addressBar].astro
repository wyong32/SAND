---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ammunition } from '../../../data/wiki/ammunition.js';
import { weapons } from '../../../data/wiki/weapons.js';
import { getSidebarIcon } from '../../../data/sidebar-icons.js';
import '../../../styles/pages/inner-page.css';
import '../../../styles/pages/wiki-detail-page.css';

export function getStaticPaths() {
  return ammunition.map((ammo) => ({
    params: { addressBar: ammo.addressBar },
    props: { entry: ammo }
  }));
}

const { entry } = Astro.props;
const detailUrl = `/wiki/ammunition/${entry.addressBar}`;
const ammoFamilyByTitle = new Map(ammunition.map((ammo) => [ammo.title, ammo.family]));
const linkedWeapons = weapons.filter(
  (weapon) =>
    weapon.ammo === entry.title ||
    (weapon.ammo != null && ammoFamilyByTitle.get(weapon.ammo) === entry.family)
);
const recommendedAmmo = ammunition
  .filter((ammo) => ammo.addressBar !== entry.addressBar)
  .sort((a, b) => (b.family === entry.family ? 1 : 0) - (a.family === entry.family ? 1 : 0))
  .slice(0, 6);
const statRows = [
  ['Rarity', entry.rarity],
  ['Type', entry.type],
  ['Value', entry.value],
  ['Trampler Damage', entry.tramplerDamage],
  ['Structure Damage', entry.structureDamage]
].filter(([, value]) => value);

const noteRows = [
  ['Family', entry.family],
  ['Type', entry.type],
  ['Rarity', entry.rarity],
  ['Value', entry.value],
  ['Updated', entry.publishDate]
].filter(([, value]) => value);
---

<BaseLayout title={entry.seo.title} description={entry.seo.description} keywords={entry.seo.keywords} pageUrl={detailUrl} pageType="article" lastUpdated={entry.publishDate}>
<main>
      <section class="inner-shell-section">
        <div class="container">
          <div class="inner-shell-content">
            <div class="inner-mainframe">
              <!-- Wiki三级详情：弹药独立页面 -->
              <section class="wiki-detail-hero-section">
                <div class="container">
                  <div class="wiki-detail-hero-content">
                    <div>
                      <a href="/wiki/ammunition">Ammunition</a>
                      <span>{entry.family} / {entry.type}</span>
                      <h1>SAND: Raiders of Sophie Wiki - {entry.title}</h1>
                      <p>{entry.intro} Use this SAND: Raiders of Sophie Wiki ammunition entry to compare family data, damage fields, linked weapons, and related ammo options.</p>
                    </div>
                    <img src={entry.imageUrl} alt={entry.imageAlt} />
                  </div>
                </div>
              </section>

              <section class="wiki-detail-body-section">
                <div class="container">
                  <div class="wiki-detail-body-content">
                    <article>
                      <h2>{entry.title} Stats and Compatible Weapon Data</h2>
                      <table class="weapon-stat-table">
                        <tbody>
                          {statRows.map(([label, value]) => (
                            <tr><th>{label}</th><td>{value}</td></tr>
                          ))}
                        </tbody>
                      </table>

                      <h2>How to Use This SAND Ammo Entry</h2>
                      <p>
                        Use this ammunition entry to check its family, rarity, value, damage fields, and linked weapon usage. When a weapon page references this ammo type, follow the compatible weapon links below to compare the practical loadout options.
                      </p>

                      {entry.variants.length > 0 && (
                        <>
                          <h2>{entry.title} Variants and Notes</h2>
                          <div class="weapon-variant-grid">
                            {entry.variants.map((variant) => (
                              <section>
                                <h3>{variant.label}</h3>
                                <table class="weapon-stat-table compact">
                                  <tbody>
                                    {variant.rarity && <tr><th>Rarity</th><td>{variant.rarity}</td></tr>}
                                    {variant.type && <tr><th>Type</th><td>{variant.type}</td></tr>}
                                    {variant.value && <tr><th>Value</th><td>{variant.value}</td></tr>}
                                    {variant.tramplerDamage && <tr><th>Trampler Damage</th><td>{variant.tramplerDamage}</td></tr>}
                                    {variant.structureDamage && <tr><th>Structure Damage</th><td>{variant.structureDamage}</td></tr>}
                                  </tbody>
                                </table>
                                {variant.note && <p>{variant.note}</p>}
                              </section>
                            ))}
                          </div>
                        </>
                      )}

                      {linkedWeapons.length > 0 && (
                        <>
                          <h2>SAND Weapons Using This Ammo</h2>
                          <div class="weapon-recommend-grid">
                            {linkedWeapons.map((weapon) => (
                              <a href={`/wiki/weapons/${weapon.addressBar}`} aria-label={weapon.title}>
                                <img src={weapon.imageUrl} alt={weapon.imageAlt} />
                                <span>{weapon.title}</span>
                                <b>{weapon.family}</b>
                              </a>
                            ))}
                          </div>
                        </>
                      )}

                      <h2>Related SAND Ammunition to Compare</h2>
                      <div class="weapon-recommend-grid">
                        {recommendedAmmo.map((ammo) => (
                          <a href={`/wiki/ammunition/${ammo.addressBar}`} aria-label={ammo.title}>
                            <img src={ammo.imageUrl} alt={ammo.imageAlt} />
                            <span>{ammo.title}</span>
                            <b>{ammo.family}</b>
                          </a>
                        ))}
                      </div>
                    </article>
                    <aside>
                      <h2>Ammunition Reference Notes</h2>
                      <dl>
                        {noteRows.map(([label, value]) => (
                          <div><dt>{label}</dt><dd>{value}</dd></div>
                        ))}
                      </dl>
                    </aside>
                  </div>
                </div>
              </section>
            </div>

            <aside class="inner-sidebar" aria-label="SAND wiki menu">
              <div class="inner-sidebar-head">
                <img src={entry.imageUrl} alt={entry.imageAlt} />
                <div><strong>Entry</strong><span>Ammo File</span></div>
              </div>
              <nav class="inner-nav-group" aria-label="Ammunition Entry">
                <h2>Entry</h2>
                <a class="is-active" href={detailUrl}><img src={entry.imageUrl} alt="" /><span>{entry.title}</span><b>Open</b></a>
                <a href="/wiki/ammunition"><img src={getSidebarIcon('Ammunition List', '/wiki/ammunition')} alt="" /><span>Ammunition List</span><b>Back</b></a>
                <a href="/wiki/weapons"><img src={getSidebarIcon('Weapons', '/wiki/weapons')} alt="" /><span>Weapons</span><b>{weapons.length}</b></a>
              </nav>
            </aside>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
